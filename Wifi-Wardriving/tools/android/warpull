#!/usr/bin/env bash
# warpull — Descarga las capturas del móvil al PC (por USB/ADB o por Wi-Fi SSH)
#           y genera automáticamente el informe en consola, dashboard.html,
#           wigle.csv y redes.csv en Wifi-Wardriving/wardrive_data/.
set -euo pipefail

PROJECT_DIR="/home/Kta41/GITHUB/ESP32_projects/Wifi-Wardriving"
SIGINT_CONSOLE_DATA="/home/Kta41/GITHUB/SIGINT-Console/data"
OUT_DIR="${1:-$PROJECT_DIR/wardrive_data}"
ADB_BIN="${ADB_BIN:-$HOME/.local/bin/adb}"
SSH_PORT="${SSH_PORT:-8022}"
PHONE_WIFI_IP="${PHONE_WIFI_IP:-192.168.1.15}"
REMOTE_DIR="~/kali-arm64/home/Kta41/wardrive/wardrive_data"

mkdir -p "$OUT_DIR"

TARGET_HOST=""
if [ -x "$ADB_BIN" ] && "$ADB_BIN" get-state >/dev/null 2>&1; then
    "$ADB_BIN" forward "tcp:${SSH_PORT}" "tcp:${SSH_PORT}" >/dev/null
    TARGET_HOST="127.0.0.1"
    echo "[warpull] Móvil detectado por cable USB (ADB -> 127.0.0.1:${SSH_PORT})"
else
    # Sincronizar entrada ARP desde Windows hacia WSL mirrored mode si está STALE/INCOMPLETE
    WIN_MAC="$(powershell.exe -NoProfile -Command "(Get-NetNeighbor -IPAddress '$PHONE_WIFI_IP' -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty LinkLayerAddress)" 2>/dev/null | tr -d '\r\n' | tr '-' ':' | tr '[:upper:]' '[:lower:]')"
    if [ -n "$WIN_MAC" ]; then
        wsl.exe -d Debian -u root -- ip neigh replace "$PHONE_WIFI_IP" lladdr "$WIN_MAC" dev eth0 nud reachable 2>/dev/null || true
    fi
    TARGET_HOST="$PHONE_WIFI_IP"
    echo "[warpull] Conectando al móvil por Wi-Fi (${TARGET_HOST}:${SSH_PORT})..."
fi

SSH_OPTS=(-p "$SSH_PORT" -o StrictHostKeyChecking=no -o ConnectTimeout=6)
SCP_OPTS=(-P "$SSH_PORT" -o StrictHostKeyChecking=no -o ConnectTimeout=6)

REMOTE_USER="$(ssh "${SSH_OPTS[@]}" "$TARGET_HOST" whoami 2>/dev/null || echo u0_a333)"

echo "[warpull] Descargando capturas desde ${REMOTE_USER}@${TARGET_HOST}:${REMOTE_DIR} ..."
scp "${SCP_OPTS[@]}" "${REMOTE_USER}@${TARGET_HOST}:${REMOTE_DIR}/wardrive_*.jsonl" "$OUT_DIR/"
scp "${SCP_OPTS[@]}" "${REMOTE_USER}@${TARGET_HOST}:${REMOTE_DIR}/tags.json" "$OUT_DIR/" 2>/dev/null || true

shopt -s nullglob
FILES=("$OUT_DIR"/wardrive_*.jsonl)
if [ "${#FILES[@]}" -eq 0 ]; then
    echo "[warpull] No se encontraron archivos wardrive_*.jsonl."
    exit 1
fi

python3 "$PROJECT_DIR/tools/validate.py" "${FILES[@]}"
python3 "$PROJECT_DIR/tools/warmap.py" "${FILES[@]}" \
    --csv "$OUT_DIR/redes.csv" \
    --wigle "$OUT_DIR/wigle.csv" \
    --html "$OUT_DIR/dashboard.html"

if [ -d "$SIGINT_CONSOLE_DATA" ]; then
    cp -f "$OUT_DIR"/wardrive_*.jsonl "$SIGINT_CONSOLE_DATA/" 2>/dev/null || true
    [ -f "$OUT_DIR/tags.json" ] && cp -f "$OUT_DIR/tags.json" "$SIGINT_CONSOLE_DATA/" || true
    echo "[warpull] Sincronizado automáticamente con SIGINT-Console ($SIGINT_CONSOLE_DATA)"
fi

echo ""
echo "[warpull] Archivos listos en el PC:"
echo "  • JSONL     : $OUT_DIR/wardrive_*.jsonl"
echo "  • Dashboard : $OUT_DIR/dashboard.html"
echo "  • WiGLE CSV : $OUT_DIR/wigle.csv"
echo "  • Tabla CSV : $OUT_DIR/redes.csv"
